# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and fill in your own values.
# docker-compose reads `.env` automatically via the `env_file:` directive.
# ---------------------------------------------------------------------------

# --- MySQL ---
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=chatapp
DB_USER=chatapp
DB_PASS=replace_with_a_strong_app_db_password

# --- JWT ---
# Required: use a long random value, at least 32 characters.
# Example: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# --- HTTP / CORS ---
# Use * for native-only/local development. For web deployments, set your exact origin.
CORS_ALLOW_ORIGIN=*

# --- Brevo (transactional email for the email-verification flow) ---
# Get a key from https://app.brevo.com/settings/keys/api
# If BREVO_API_KEY is left empty, verification codes are logged to stdout
# instead of being emailed (useful for local development).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=ChatApp
